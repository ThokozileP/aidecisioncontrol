---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ThemeCard from '../components/ThemeCard.astro';
import { eventThemes, eventFormats } from '../data/eventThemes';
import { inauguralForum } from '../data/inauguralForum';
import { mailto } from '../consts';
---

<BaseLayout
  title="Events"
  description="Expert conversations on control at the point of decision. The AI Decision Control Forum runs invitation-only roundtables, practitioner sessions and cross-sector discussions."
>
  <section class="section hero">
    <div class="wrapper">
      <p class="eyebrow">Events</p>
      <h1>Expert conversations on control at the point of decision.</h1>
      <p class="lede">
        The Forum's events bring practitioners together to work through the operational questions
        that AI governance alone does not answer.
      </p>
      <a class="button button--primary" href={mailto('AI Decision Control Events')}>
        Register interest in future events
      </a>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrapper">
      <p class="eyebrow">Featured event</p>
      <a class="card featured-event" href={inauguralForum.path}>
        <span class="tag">{inauguralForum.eyebrow}</span>
        <h2>{inauguralForum.title}</h2>
        <p class="lede featured-event__lede">{inauguralForum.subtitle}</p>
        <dl class="featured-event__meta">
          <div>
            <dt>Date</dt>
            <dd>{inauguralForum.dateHeadline}</dd>
          </div>
          <div>
            <dt>Location</dt>
            <dd>{inauguralForum.locationHeadline}</dd>
          </div>
        </dl>
        <span class="featured-event__cta">View event details →</span>
      </a>
    </div>
  </section>

  <section class="section">
    <div class="wrapper">
      <SectionHeading heading="Format" />
      <ul class="format-list">
        {eventFormats.map((format) => <li class="card">{format}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrapper">
      <SectionHeading heading="Proposed discussion themes" lede="Beyond the inaugural Forum, these themes outline the questions future Forum events are expected to address." />
      <div class="grid grid--2">
        {eventThemes.map((theme) => <ThemeCard title={theme.title} description={theme.description} />)}
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="wrapper cta-block">
      <h2>The inaugural Forum is now open for requests.</h2>
      <p>
        Request an invitation to the inaugural Forum, targeted for the first week of December 2026,
        or register your interest and we'll be in touch as the rest of the Forum's event programme
        takes shape.
      </p>
      <div class="cta-block__ctas">
        <a class="button button--primary" href={`${inauguralForum.path}#request-invitation`}>
          Request an Invitation
        </a>
        <a class="button button--ghost" href={mailto('AI Decision Control Events')}>
          Register interest in future events
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero h1 {
    font-size: clamp(2rem, 1.5rem + 2vw, 2.75rem);
    max-width: 22ch;
    margin-top: var(--space-1);
  }

  .hero .lede {
    margin-block: var(--space-2) var(--space-3);
    max-width: 56ch;
  }

  .format-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-2);
  }

  .format-list li {
    font-weight: 600;
    color: var(--color-navy);
  }

  .cta-block {
    max-width: 40rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .cta-block p {
    color: var(--color-steel);
  }

  .cta-block__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-1);
  }

  .featured-event {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    text-decoration: none;
    max-width: 42rem;
    transition: border-color 0.15s ease;
  }

  .featured-event:hover {
    border-color: var(--color-navy);
  }

  .featured-event h2 {
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2rem);
  }

  .featured-event__lede {
    color: var(--color-ink-muted);
  }

  .featured-event__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: 0.4rem;
  }

  .featured-event__meta dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-ink-muted);
  }

  .featured-event__meta dd {
    margin: 0.15rem 0 0;
    font-weight: 600;
    color: var(--color-navy);
  }

  .featured-event__cta {
    margin-top: 0.4rem;
    font-weight: 600;
    color: var(--color-navy);
  }
</style>
