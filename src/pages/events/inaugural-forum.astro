---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { InvitationRequestForm } from '../../components/events/InvitationRequestForm';
import {
  inauguralForum,
  coreQuestion,
  autonomyStages,
  controlThemes,
  coreQuestions,
  eventSectors,
  formatSteps,
  audienceRoles,
} from '../../data/inauguralForum';
import '../../styles/membership.css';
import '../../styles/events.css';
---

<BaseLayout title={inauguralForum.seoTitle} description={inauguralForum.seoDescription}>
  <!-- Hero -->
  <section class="section hero">
    <div class="wrapper hero-inner">
      <p class="eyebrow">{inauguralForum.eyebrow}</p>
      <h1>{inauguralForum.title}</h1>
      <p class="lede hero-lede">{inauguralForum.subtitle}</p>

      <div class="hero-copy">
        <p>
          AI is moving rapidly from assisting people to making decisions, initiating actions and
          automating entire workflows.
        </p>
        <p>
          As organisations accelerate toward agentic AI, the question is no longer simply how AI
          should be governed — but how decision authority, accountability and operational control
          can be maintained when AI systems increasingly act on behalf of organisations.
        </p>
      </div>

      <div class="hero-ctas">
        <a class="button button--primary" href="#request-invitation">Request an Invitation</a>
        <a class="button button--secondary" href="/about">Explore the Forum</a>
      </div>
    </div>
  </section>

  <!-- Event information -->
  <section class="section section--alt">
    <div class="wrapper">
      <dl class="event-info">
        <div class="event-info__item">
          <dt class="tag">Date</dt>
          <dd>{inauguralForum.dateHeadline}</dd>
          <p class="event-info__detail">{inauguralForum.dateDetail}</p>
        </div>
        <div class="event-info__item">
          <dt class="tag">Location</dt>
          <dd>{inauguralForum.locationHeadline}</dd>
          <p class="event-info__detail">{inauguralForum.locationDetail}</p>
        </div>
        <div class="event-info__item">
          <dt class="tag">Format</dt>
          <dd>{inauguralForum.format}</dd>
        </div>
        <div class="event-info__item">
          <dt class="tag">Audience</dt>
          <dd class="event-info__audience">{inauguralForum.audience}</dd>
        </div>
        <div class="event-info__item">
          <dt class="tag">Size</dt>
          <dd class="event-info__audience">{inauguralForum.size}</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- Why this conversation matters -->
  <section class="section" id="why-it-matters">
    <div class="wrapper">
      <SectionHeading
        eyebrow="Why this conversation matters"
        heading="From assistance to execution."
        lede="As AI moves from recommendation toward execution, organisations face increasingly important questions about decision authority, delegation and control. This transition is ongoing, not complete."
      />

      <div class="progression">
        {
          autonomyStages.map((item, index) => (
            <div class="progression__step">
              <span class="tag">{String(index + 1).padStart(2, '0')}</span>
              <h3>{item.stage}</h3>
              <p>{item.description}</p>
            </div>
          ))
        }
      </div>

      <div class="control-themes">
        <p class="control-themes__label tag">Questions this raises</p>
        <ul class="control-themes__list">
          {controlThemes.map((theme) => <li>{theme}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- The questions we need to answer -->
  <section class="section section--dark">
    <div class="wrapper">
      <SectionHeading eyebrow="An invitation to contribute" heading="The questions we need to answer." />
      <p class="lede core-question">{coreQuestion}</p>

      <div class="grid grid--2 questions-grid">
        {
          coreQuestions.map((item) => (
            <div class="card question-card">
              <span class="tag">{item.number}</span>
              <p>{item.question}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Cross-sector perspective -->
  <section class="section" id="cross-sector">
    <div class="wrapper">
      <SectionHeading
        eyebrow="Cross-sector perspective"
        heading="One problem. Different regulated environments."
        lede="Financial services, healthcare, insurance, energy, transport and other regulated environments face different risks and regulatory requirements. Yet they increasingly share a common challenge: how to delegate decision-making to AI without losing organisational authority and control."
      />
      <div class="grid grid--3 sector-grid">
        {
          eventSectors.map((sector) => (
            <div class="card sector-card">
              <h3>{sector.name}</h3>
              <p>{sector.challenge}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Event format -->
  <section class="section section--alt" id="format">
    <div class="wrapper">
      <SectionHeading
        eyebrow="A different kind of AI event"
        heading="An invitation-led practitioner discussion."
        lede="The inaugural Forum is designed as an invitation-led practitioner discussion rather than a traditional conference."
      />
      <ol class="format-steps">
        {
          formatSteps.map((step) => (
            <li class="format-steps__item">
              <span class="tag">{step.number}</span>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Who should attend -->
  <section class="section">
    <div class="wrapper">
      <SectionHeading
        eyebrow="Who should be in the room?"
        heading="Practitioners working on organisational AI decision-making and control."
      />
      <ul class="audience-grid">
        {audienceRoles.map((role) => <li class="card audience-item">{role}</li>)}
      </ul>
    </div>
  </section>

  <!-- Request an invitation -->
  <section class="section section--alt" id="request-invitation">
    <div class="wrapper invitation-section">
      <div class="invitation-section__intro">
        <p class="eyebrow">Request an invitation</p>
        <h2>Join the conversation.</h2>
        <p class="lede">
          This is initially an invitation-led event. Tell us about yourself and your organisation's
          questions, and we will review your request and contact you with event details as they are
          confirmed.
        </p>
      </div>
      <div class="invitation-section__form">
        <InvitationRequestForm client:load />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    background: var(--color-navy);
    color: var(--color-white);
    padding-bottom: 5rem;
  }

  .hero-inner {
    max-width: 46rem;
  }

  .hero h1 {
    color: var(--color-white);
    font-size: clamp(2.1rem, 1.5rem + 2.6vw, 3.25rem);
    margin-top: var(--space-1);
    max-width: 18ch;
  }

  .hero-lede {
    color: var(--color-steel);
    margin-top: var(--space-2);
    font-size: 1.2rem;
    max-width: 46ch;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-4);
    max-width: 54ch;
  }

  .hero-copy p {
    color: #d3dce8;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  /* ---------- Event information ---------- */
  .event-info {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  .event-info__item dt {
    margin-bottom: 0.4rem;
  }

  .event-info__item dd {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.3rem;
    color: var(--color-navy);
  }

  .event-info__detail {
    margin-top: 0.3rem;
    font-size: 0.85rem;
    color: var(--color-ink-muted);
  }

  .event-info__audience {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 500;
    max-width: 32ch;
  }

  @media (min-width: 768px) {
    .event-info {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .event-info {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  /* ---------- Progression ---------- */
  .progression {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-3);
  }

  .progression__step {
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .progression__step h3 {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .progression__step p {
    font-size: 0.9rem;
    color: var(--color-ink-muted);
    max-width: 52ch;
  }

  @media (min-width: 960px) {
    .progression {
      grid-template-columns: repeat(5, 1fr);
      border-bottom: 1px solid var(--color-border);
    }

    .progression__step {
      border-bottom: none;
      border-left: 1px solid var(--color-border);
      padding: 0 var(--space-2);
    }

    .progression__step:first-child {
      border-left: none;
      padding-left: 0;
    }
  }

  .control-themes {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  .control-themes__label {
    margin-bottom: var(--space-2);
  }

  .control-themes__list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .control-themes__list li {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-navy-deep);
  }

  /* ---------- Core question / questions grid ---------- */
  .core-question {
    margin-top: var(--space-2);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.3rem;
    max-width: 48ch;
    color: var(--color-white);
  }

  .questions-grid {
    margin-top: var(--space-4);
  }

  .question-card {
    background: var(--color-navy-deep);
    border-color: rgba(255, 255, 255, 0.14);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .question-card .tag {
    color: var(--color-steel);
  }

  .question-card p {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: var(--color-white);
    max-width: none;
  }

  /* ---------- Sector cards ---------- */
  .sector-grid {
    margin-top: var(--space-4);
  }

  .sector-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .sector-card p {
    color: var(--color-ink-muted);
    font-size: 0.92rem;
  }

  /* ---------- Format steps ---------- */
  .format-steps {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .format-steps__item {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .format-steps__item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .format-steps__item h3 {
    font-size: 1.15rem;
  }

  .format-steps__item p {
    color: var(--color-ink-muted);
    max-width: 60ch;
  }

  @media (min-width: 768px) {
    .format-steps__item {
      display: grid;
      grid-template-columns: 3rem 1fr;
      column-gap: var(--space-3);
      align-items: baseline;
    }

    .format-steps__item h3 {
      grid-column: 2;
    }

    .format-steps__item p {
      grid-column: 2;
    }
  }

  /* ---------- Audience ---------- */
  .audience-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .audience-item {
    font-weight: 600;
    color: var(--color-navy);
  }

  /* ---------- Request an invitation ---------- */
  .invitation-section {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  .invitation-section__intro h2 {
    margin-top: var(--space-1);
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.25rem);
  }

  .invitation-section__intro .lede {
    margin-top: var(--space-2);
  }

  .invitation-section__form {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-3);
  }

  @media (min-width: 768px) {
    .invitation-section__form {
      padding: var(--space-4);
    }
  }

  @media (min-width: 1024px) {
    .invitation-section {
      grid-template-columns: 0.9fr 1.4fr;
      align-items: start;
    }

    .invitation-section__intro {
      position: sticky;
      top: 6rem;
    }
  }
</style>
