---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ThemeCard from '../../components/ThemeCard.astro';
import { perspectivesConcepts } from '../../data/perspectivesConcepts';

const articles = (await getCollection('perspectives', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<BaseLayout
  title="Perspectives"
  description="Articles, practitioner notes and Forum outputs exploring the operational control of AI-supported decisions and actions."
>
  <section class="section hero">
    <div class="wrapper">
      <p class="eyebrow">Perspectives</p>
      <h1>Articles and practitioner notes on AI Decision Control.</h1>
      <p class="lede">
        Perspectives will hold articles, practitioner notes and outputs from the Forum's
        roundtables and working groups. The concepts below outline the questions this work will
        address.
      </p>
    </div>
  </section>

  {
    articles.length > 0 && (
      <section class="section section--alt">
        <div class="wrapper">
          <SectionHeading heading="Latest" />
          <ul class="grid grid--2">
            {articles.map((article) => (
              <li class="card">
                <a class="article-link" href={`/perspectives/${article.id}`}>
                  <h3>{article.data.title}</h3>
                  <p>{article.data.description}</p>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="wrapper">
      <SectionHeading heading="In development" />
      <div class="grid grid--2">
        {
          perspectivesConcepts.map((concept) => (
            <ThemeCard title={concept.title} description={concept.description} badge="Coming soon" />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero h1 {
    font-size: clamp(2rem, 1.5rem + 2vw, 2.75rem);
    max-width: 24ch;
    margin-top: var(--space-1);
  }

  .hero .lede {
    margin-top: var(--space-2);
    max-width: 56ch;
  }

  .article-link {
    text-decoration: none;
    display: block;
  }

  .article-link p {
    color: var(--color-ink-muted);
    margin-top: 0.5rem;
  }
</style>
