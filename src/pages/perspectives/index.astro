---
export const prerender = true;
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { mailto } from '../../consts';
import { perspectivesConcepts } from '../../data/perspectivesConcepts';
import { publishedResearch } from '../../data/publishedResearch';

const articles = (await getCollection('perspectives', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<BaseLayout
  title="Perspectives"
  description="Published research, practitioner notes and outputs from the Forum's roundtables and working groups, exploring the operational control of AI-supported decisions and actions."
>
  <section class="section section--dark perspectives-header">
    <div class="wrapper">
      <p class="eyebrow">Perspectives</p>
      <h1>Articles and practitioner notes on AI Decision Control.</h1>
      <p class="lede">
        Published research, practitioner notes, and outputs from the Forum's roundtables and
        working groups, exploring the operational control of AI-supported decisions and actions.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrapper">
      <div class="section-head">
        <div>
          <p class="section-label">Published</p>
          <h2>Research from the Forum's founder.</h2>
        </div>
        <span class="section-count">{publishedResearch.length} published</span>
      </div>

      {
        publishedResearch.map((record) => (
          <div class="article-card">
            <div>
              <span class="status status--published">{record.status}</span>
              <h3>{record.title}</h3>
              <p>{record.description}</p>
              <p class="article-meta">
                By {record.author} &middot; DOI {record.doi}
              </p>
            </div>
            <a class="article-card__go" href={record.doiUrl}>
              View record <span aria-hidden="true">&rarr;</span>
              <span class="visually-hidden"> (opens the Zenodo record, leaves this site)</span>
            </a>
          </div>
        ))
      }
    </div>
  </section>

  {
    articles.length > 0 && (
      <section class="section section--alt">
        <div class="wrapper">
          <div class="section-head">
            <div>
              <p class="section-label">Latest</p>
              <h2>From the Forum.</h2>
            </div>
          </div>
          <ul class="grid grid--2">
            {articles.map((article) => (
              <li class="card">
                <a class="article-link" href={`/perspectives/${article.id}`}>
                  <h3>{article.data.title}</h3>
                  <p>{article.data.description}</p>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="wrapper">
      <div class="section-head">
        <div>
          <p class="section-label">In development</p>
          <h2>What Perspectives will cover next.</h2>
        </div>
        <span class="section-count">{perspectivesConcepts.length} in progress</span>
      </div>
      <div class="soon-grid">
        {
          perspectivesConcepts.map((concept) => (
            <div class="soon-cell">
              <span class="status">Coming soon</span>
              <h3>{concept.title}</h3>
              <p>{concept.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrapper">
      <div class="notify">
        <div>
          <p class="section-label notify__label">Stay updated</p>
          <p class="notify__copy">Get notified when the next Perspective publishes. One email, no spam.</p>
        </div>
        <form class="notify__form" id="notify-form">
          <label class="visually-hidden" for="notify-email">Email address</label>
          <input
            class="notify__input"
            id="notify-email"
            type="email"
            placeholder="you@organisation.com"
            required
          />
          <button class="notify__submit" type="submit" aria-live="polite">Notify me</button>
        </form>
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="wrapper">
      <p class="eyebrow">Contribute</p>
      <h2>Working on relevant research?</h2>
      <p class="lede">
        The Forum is looking for practitioner contributions, case discussions and working-group
        outputs from people working across AI engineering, risk, healthcare, financial services,
        assurance, regulation and research.
      </p>
      <a class="button button--primary contribute__cta" href={mailto('Contribute a Perspective')}>
        Pitch a Perspective
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .perspectives-header h1 {
    color: var(--color-white);
    font-size: clamp(1.9rem, 1.4rem + 2vw, 2.6rem);
    max-width: 20ch;
    margin-top: var(--space-1);
  }

  .perspectives-header .lede {
    margin-top: var(--space-2);
    max-width: 58ch;
  }

  .section-head {
    max-width: none;
    margin-bottom: var(--space-3);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .section-head h2 {
    font-size: clamp(1.3rem, 1.1rem + 1vw, 1.7rem);
    max-width: 26ch;
    margin-top: 0.4rem;
  }

  .section-count {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    white-space: nowrap;
  }

  /* Published article card */
  .article-card {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-3);
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .status {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    margin-bottom: 0.7rem;
  }

  .status--published {
    color: var(--color-allow);
    background: #ebf3ef;
    border: 1px solid #cfe3d8;
    padding: 0.2rem 0.5rem;
    border-radius: 2px;
  }

  .article-card h3 {
    font-size: 1.15rem;
    margin-bottom: 0.4rem;
  }

  .article-card p {
    color: var(--color-ink-muted);
    font-size: 0.95rem;
  }

  .article-meta {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-ink-muted);
    margin-top: 0.8rem;
  }

  .article-card__go {
    flex: 0 0 auto;
    font-size: 0.9rem;
    color: var(--color-navy);
    text-decoration: none;
    border-bottom: 1px solid var(--color-navy);
    padding-bottom: 2px;
    white-space: nowrap;
  }

  /* Coming-soon cards: muted, visually distinct from the published card */
  .soon-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
  }

  .soon-cell {
    background: #f7f8fa;
    padding: var(--space-3);
  }

  .soon-cell h3 {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1rem;
    color: var(--color-ink-muted);
    margin-bottom: 0.4rem;
  }

  .soon-cell p {
    font-size: 0.9rem;
    color: #7a8699;
  }

  .article-link {
    text-decoration: none;
    display: block;
  }

  .article-link p {
    color: var(--color-ink-muted);
    margin-top: 0.5rem;
  }

  /* Notify strip */
  .notify {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-3);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .notify__label {
    margin-bottom: 0.3rem;
  }

  .notify__copy {
    font-size: 0.95rem;
  }

  .notify__form {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .notify__input {
    font: inherit;
    font-size: 0.9rem;
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--color-border);
    border-radius: 3px;
    min-width: 15rem;
  }

  .notify__submit {
    font: inherit;
    font-weight: 600;
    font-size: 0.9rem;
    background: var(--color-navy);
    color: var(--color-white);
    border: none;
    padding: 0.65rem 1.1rem;
    border-radius: 3px;
    cursor: pointer;
  }

  .notify__submit:hover {
    background: var(--color-navy-deep);
  }

  .contribute__cta {
    margin-top: var(--space-3);
  }

  @media (max-width: 880px) {
    .soon-grid {
      grid-template-columns: 1fr;
    }

    .article-card {
      flex-direction: column;
    }

    .notify {
      flex-direction: column;
      align-items: stretch;
    }

    .notify__form {
      flex-direction: column;
    }

    .notify__input {
      min-width: 0;
    }
  }
</style>

<script>
  const form = document.getElementById('notify-form');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const button = form.querySelector('.notify__submit');
    if (button) button.textContent = 'Added';
  });
</script>
