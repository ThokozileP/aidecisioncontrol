---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('perspectives', ({ data }) => !data.draft);
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
---

<BaseLayout title={article.data.title} description={article.data.description}>
  <article class="section">
    <div class="wrapper article">
      <p class="eyebrow">Perspectives</p>
      <h1>{article.data.title}</h1>
      <p class="lede">{article.data.description}</p>
      {article.data.author && <p class="article__meta">{article.data.author}</p>}
      <div class="article__body">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .article {
    max-width: 68ch;
  }

  .article h1 {
    font-size: clamp(1.8rem, 1.4rem + 1.6vw, 2.5rem);
    margin-top: var(--space-1);
  }

  .article .lede {
    margin-top: var(--space-2);
  }

  .article__meta {
    color: var(--color-steel);
    font-size: 0.9rem;
    margin-top: var(--space-1);
  }

  .article__body {
    margin-top: var(--space-4);
    color: var(--color-ink-muted);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .article__body :global(h2) {
    margin-top: var(--space-3);
  }
</style>
