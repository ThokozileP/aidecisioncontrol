---
import type { Sector } from '../data/sectors';

interface Props {
  index: number;
  sector: Sector;
}

const { index, sector } = Astro.props;
---

<div class="industry-panel">
  <div class="industry-panel__head">
    <h3>{sector.name}</h3>
    <span class="tag">Sector {String(index + 1).padStart(2, '0')}</span>
  </div>
  <ul class="industry-panel__examples">
    {sector.examples.map((example) => <li>{example}</li>)}
  </ul>
  <p class="industry-panel__question">{sector.question}</p>
</div>

<style>
  .industry-panel {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .industry-panel__head {
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--color-border);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2);
  }

  .industry-panel__head h3 {
    font-size: 1.2rem;
  }

  .industry-panel__examples {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.55rem 1rem;
    padding: var(--space-2) var(--space-3);
    color: var(--color-ink-muted);
    font-size: 0.9rem;
  }

  .industry-panel__examples li {
    padding-left: 0.9rem;
    position: relative;
  }

  .industry-panel__examples li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 6px;
    height: 1px;
    background: var(--color-ink-muted);
  }

  .industry-panel__question {
    padding: var(--space-2) var(--space-3);
    border-top: 1px solid var(--color-border);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--color-navy);
    max-width: none;
  }
</style>
