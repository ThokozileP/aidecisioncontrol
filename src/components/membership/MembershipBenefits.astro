---
import SectionHeading from '../SectionHeading.astro';

const benefits = [
  {
    tag: '01 · Community',
    title: 'Connect with practitioners',
    description:
      'Engage with professionals working across AI governance, risk, compliance, safety and regulation, and build relationships across sectors facing the same operational questions.',
  },
  {
    tag: '02 · Events',
    title: '20% off Forum events',
    description:
      'Members receive a 20% discount on eligible AI Decision Control Forum event tickets, applied automatically at checkout.',
  },
  {
    tag: '03 · Resources',
    title: 'Access selected research',
    description:
      "Receive access to selected Forum resources, research and practical AI governance materials as they're published.",
  },
  {
    tag: '04 · Participation',
    title: 'Shape the conversation',
    description:
      'Contribute insights, participate in discussions, and get early access to selected events and programmes as they open.',
  },
];
---

<section class="section section--alt">
  <div class="wrapper">
    <SectionHeading eyebrow="Why join" heading="What membership includes." />
    <div class="benefit-grid">
      {
        benefits.map(({ tag, title, description }) => (
          <div class="benefit-cell">
            <span class="tag">{tag}</span>
            <h3>{title}</h3>
            <p>{description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .benefit-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
  }

  .benefit-cell {
    background: var(--color-white);
    padding: var(--space-3);
  }

  .benefit-cell h3 {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--color-ink);
    margin: 0.5rem 0;
  }

  .benefit-cell p {
    font-size: 0.9rem;
    color: var(--color-ink-muted);
  }

  @media (max-width: 880px) {
    .benefit-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
